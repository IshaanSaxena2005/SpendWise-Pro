# ML-Service environment (copy to .env for local development)
#
# Shared secret required on all POST endpoints (/categorize, /forecast, /anomaly)
# via the "x-ml-api-key" request header. Must match the Backend's ML_API_KEY.
# If unset, the service FAILS CLOSED: every POST is rejected with 503
# (see _require_ml_api_key in app.py). /health never requires the key.
ML_API_KEY=replace_with_shared_secret

# Server binding (Flask dev server; gunicorn uses $PORT from the platform)
HOST=0.0.0.0
PORT=5001

# Enable the Werkzeug debugger ONLY for local development. Never true in production.
DEBUG=false
